generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


// ==================== USER ====================

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String

  // Available cash balance in INR
  balance Decimal @default(100000.00)

  refreshToken String? @db.Text

  holdings     Holding[]
  orders       Order[]
  transactions Transaction[]
  watchlists   Watchlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ==================== STOCKS ====================

model Stocks {
  segment         String
  name            String
  exchange        String
  instrument_type String
  instrument_key  String @id
  trading_symbol  String

  holdings     Holding[]
  orders       Order[]
  transactions Transaction[]
  watchlists   Watchlist[]

  @@index([name, instrument_key])
}


// ==================== HOLDING ====================

model Holding {
  id       String  @id @default(uuid())
  quantity Decimal @default(0)
  avgPrice Decimal @default(0)

  userId  String
  stockId String

  user  User   @relation(fields: [userId], references: [id])
  stock Stocks @relation(fields: [stockId], references: [instrument_key])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One holding per user per stock
  @@unique([userId, stockId])
}


// ==================== ORDER ====================

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  COMPLETED
  PENDING
  OPEN
  REJECTED
}

enum OrderType{
  MARKET
  LIMIT
  GTT
}

model Order {
  id            String      @id @default(uuid())

  side          OrderSide
  status        OrderStatus
  orderType     OrderType

  quantity      Decimal
  limitPrice    Decimal?
  executedPrice Decimal?
  total         Decimal?

  userId  String
  stockId String

  user  User   @relation(fields: [userId], references: [id])
  stock Stocks @relation(fields: [stockId], references: [instrument_key])

  transactions Transaction[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([stockId, createdAt])
}


// ==================== TRANSACTION ====================

enum TransactionType {
  BUY
  SELL
}

model Transaction {
  id       String          @id @default(uuid())
  type     TransactionType

  quantity Decimal
  price    Decimal
  total    Decimal

  userId  String
  stockId String
  orderId String

  user  User   @relation(fields: [userId], references: [id])
  stock Stocks @relation(fields: [stockId], references: [instrument_key])
  order Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([stockId, createdAt])
}


// ==================== WATCHLIST ====================

model Watchlist {
  id String @id @default(uuid())

  userId  String
  stockId String

  user  User   @relation(fields: [userId], references: [id])
  stock Stocks @relation(fields: [stockId], references: [instrument_key])

  createdAt DateTime @default(now())

  // Prevent duplicate stock in user's watchlist
  @@unique([userId, stockId])
}