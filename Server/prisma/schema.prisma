generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  balance   Decimal  @default(100000.00)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}